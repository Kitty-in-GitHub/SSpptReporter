{
  "name": "ssreporter",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Virtual presenter: VRM body + Director + knowledge brain",
  "scripts": {
    "dev:stop": "node scripts/dev-stop.mjs",
    "predev": "node scripts/dev-stop.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @ssreporter/presenter-onair",
    "dev:tts": "npm run start -w @ssreporter/tts-gateway",
    "setup:tts": "npm run setup -w @ssreporter/tts-gateway",
    "setup:gestures": "node apps/presenter-onair/scripts/setup-gesture-vrma.mjs",
    "build": "npm run build -w @ssreporter/presenter-onair",
    "typecheck": "npm run typecheck -w @ssreporter/director && npm run typecheck -w @ssreporter/presenter-onair",
    "test": "npm run test -w @ssreporter/director && npm run test -w @ssreporter/presenter-onair",
    "compile:deck": "npm run compile:deck -w @ssreporter/director"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
