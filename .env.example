# Example env (copy to .env locally — never commit real values)

# LLM providers (Settings UI also stores keys in localStorage by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# TTS — engine-specific keys (see Settings → TTS)
OPENAI_COMPATIBLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
INWORLD_API_KEY=
MINIMAX_API_KEY=

# Local TTS (no key; configure URL in Settings)
# VOICEVOX_URL=http://127.0.0.1:50021
