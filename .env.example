# Example env (copy to .env locally — never commit real values)

# LLM providers (Settings UI also stores keys in localStorage by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# TTS — 默认 OpenAI-Compatible → Edge-TTS 本地网关（见 docs/tts-selection.md）
# 先启动 openai-edge-tts 等服务，默认 http://127.0.0.1:5050/v1/audio/speech
OPENAI_COMPATIBLE_TTS_API_KEY=
# EDGE_TTS_URL=http://127.0.0.1:5050/v1/audio/speech
ELEVENLABS_API_KEY=
INWORLD_API_KEY=
MINIMAX_API_KEY=

# Local TTS (no key; configure URL in Settings)
# VOICEVOX_URL=http://127.0.0.1:50021
